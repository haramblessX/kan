# https://github.com/kanbn/kan?tab=readme-ov-file#environment-variables-)

# ====== REQUIRED ======

# The base URL where your Kan instance will be hosted
# For local development: http://localhost:3000
# For production: https://your-domain.com (or https://your-app.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Random 32+ character string for Better Auth session encryption
# Generate with: openssl rand -base64 26 | tr -dc 'a-zA-Z0-9' | head -c 32
BETTER_AUTH_SECRET=

# PostgreSQL database connection string
# For Supabase (recommended free option): Get from Supabase dashboard
# Format: postgresql://user:password@host:5432/database
POSTGRES_URL=

# ====== EMAIL/PASSWORD AUTH (RECOMMENDED FOR FREE SETUP) ======

# Enable email/password authentication (set to "true")
# This allows users to create accounts with email and password
NEXT_PUBLIC_ALLOW_CREDENTIALS=true

# Switch email features off entirely (recommended for cost-zero setup)
# Set to "true" to disable all email notifications
NEXT_PUBLIC_DISABLE_EMAIL=true

# ====== OPTIONAL: ONLY IF USING EXTERNAL DATABASE ======

POSTGRES_PASSWORD=

# ====== OPTIONAL: SMTP EMAIL CONFIGURATION ======
# Only needed if you want email notifications
# Can use free tier services like Resend or SendGrid

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_SECURE=
SMTP_REJECT_UNAUTHORIZED=

# ====== OPTIONAL: S3 STORAGE ======
# For file uploads (avatars, attachments)
# Can use Cloudflare R2 (free tier: 10GB), AWS S3, etc.

S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_AVATAR_BUCKET_NAME=
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=
NEXT_PUBLIC_STORAGE_DOMAIN=
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=

# ====== OPTIONAL: AUTHENTICATION CONFIG ======

# Disable new user sign-ups (set to "true" if you want invite-only)
NEXT_PUBLIC_DISABLE_SIGN_UP=false

# CORS configuration for trusted origins
BETTER_AUTH_TRUSTED_ORIGINS=

# Restrict sign-ups to specific email domains (comma-separated)
# Example: company.com,another.com
BETTER_AUTH_ALLOWED_DOMAINS=

# ====== OPTIONAL: OAUTH PROVIDERS ======
# Only needed if you want social login (Google, Discord, GitHub, etc.)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ====== OPTIONAL: API & INTEGRATIONS ======

# Request body size limit for API
# Example: 50mb (defaults to 1mb)
NEXT_API_BODY_SIZE_LIMIT=

# Trello migration integration
TRELLO_APP_API_KEY=
TRELLO_APP_SECRET=

# Redis for rate limiting (optional - in-memory used if not provided)
REDIS_URL=

# Logging level (debug, info, warn, error; defaults to debug in dev, info in prod)
LOG_LEVEL=
